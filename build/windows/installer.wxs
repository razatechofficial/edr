<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!-- Files-only MSI: WiX service rows + light.exe were failing reliably on GitHub-hosted
       Windows runners across several layouts/quoting fixes. Install binaries + default
       config; register/start the Windows service via sc.exe or a follow-up CustomAction. -->
  <Product Id="*"
           Name="EDR Agent"
           Language="1033"
           Version="$(var.Version)"
           Manufacturer="RazaTech"
           UpgradeCode="7D3A6EE5-52D7-4D6A-9D66-6AFC9FA04A90">

    <Package InstallerVersion="500" Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"
             Platform="x64"/>

    <MajorUpgrade DowngradeErrorMessage=
      "A newer version is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <Feature Id="ProductFeature" Title="EDR Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
    </Feature>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="EDR Agent"/>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents"
                    Directory="INSTALLFOLDER">
      <Component Id="AgentFiles" Guid="*" Win64="yes">
        <!-- Source is relative to this .wxs file (build/windows/), not repo root. -->
        <File Id="AgentExe"
              Source="../dist/windows-amd64/edr-agent.exe"
              KeyPath="yes"/>
        <File Id="ConfigFile"
              Source="config.yml"
              Name="config.yml"/>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
