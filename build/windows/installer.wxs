<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!--
    Native MSI only (Defender / Falcon pattern): license + progress via WixUI.
    Silent/GPO: msiexec /qn. No custom Fyne Setup, no auto-launch of the console.
    Enroll from Start Menu, or: edrctl enroll with a token.
    Service is registered after InstallFiles; operator starts it when ready.
  -->
  <Product Id="*"
           Name="EDR Agent"
           Language="1033"
           Version="$(var.MsiProductVersion)"
           Manufacturer="RazaTech"
           UpgradeCode="7D3A6EE5-52D7-4D6A-9D66-6AFC9FA04A90">

    <Package InstallerVersion="500" Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"/>

    <!-- Kill processes ourselves; do not ask Restart Manager to stop EDRAgent. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable"/>
    <Property Id="MSIRMSHUTDOWN" Value="2"/>

    <!-- Attended: native MSI license then progress. No custom installer screens. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(var.EdrLicenseRtf)"/>
    <UIRef Id="WixUI_Minimal"/>
    <UIRef Id="WixUI_ErrorProgressText"/>

    <!-- Impersonate=no: elevated stop/kill before upgrade validates files. -->
    <Binary Id="KillAgentVbs" SourceFile="$(var.KillAgentVbs)"/>
    <Binary Id="MsiPurgeVbs" SourceFile="$(var.MsiPurgeVbs)"/>
    <CustomAction Id="CaKillAgent"
                  BinaryKey="KillAgentVbs"
                  VBScriptCall=""
                  Execute="immediate"
                  Impersonate="no"
                  Return="ignore"/>
    <CustomAction Id="CaKillAgentPreUpgrade"
                  BinaryKey="KillAgentVbs"
                  VBScriptCall=""
                  Execute="immediate"
                  Impersonate="no"
                  Return="ignore"/>
    <!-- ARP uninstall: kill tray, drop Run key, wipe certs/queue (VBS), then
         edr-installer uninstall with msi flag for DPAPI/keystore + service. -->
    <CustomAction Id="CaMsiPurge"
                  BinaryKey="MsiPurgeVbs"
                  VBScriptCall=""
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>
    <CustomAction Id="CaInstallerPurge"
                  FileKey="EdrInstallerExe"
                  ExeCommand="uninstall --msi"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <!-- Do not use WiX ServiceInstall/ServiceControl (StopServices 1921 on old MSI).
         Deferred FileKey install flag after InstallFiles; Return=check so a failed
         register fails the install instead of leaving preflight red. -->
    <CustomAction Id="CaRegisterService"
                  FileKey="AgentExe"
                  ExeCommand="--install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"/>
    <CustomAction Id="CaUnregisterService"
                  FileKey="AgentExe"
                  ExeCommand="--uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <MajorUpgrade AllowSameVersionUpgrades="yes"
                  Schedule="afterInstallValidate"
                  DowngradeErrorMessage=
      "A newer version of EDR Agent is already installed. Uninstall it first, or install a newer build."/>
    <MediaTemplate EmbedCab="yes" CompressionLevel="high"/>

    <Feature Id="ProductFeature" Title="EDR Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
      <ComponentGroupRef Id="RulesComponents"/>
      <ComponentGroupRef Id="ModelsComponents"/>
    </Feature>

    <InstallExecuteSequence>
      <Custom Action="CaKillAgent" Before="InstallValidate">NOT REMOVE</Custom>
      <Custom Action="CaKillAgentPreUpgrade" Before="RemoveExistingProducts">NOT REMOVE</Custom>
      <Custom Action="CaRegisterService" After="InstallFiles">NOT REMOVE</Custom>
      <Custom Action="CaMsiPurge" Before="CaInstallerPurge">REMOVE="ALL"</Custom>
      <Custom Action="CaInstallerPurge" Before="CaUnregisterService">REMOVE="ALL"</Custom>
      <Custom Action="CaUnregisterService" Before="RemoveFiles">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>
    <InstallUISequence>
      <Custom Action="CaKillAgent" Before="ExecuteAction">NOT REMOVE</Custom>
    </InstallUISequence>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="EDR Agent"/>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAROOT" Name="EDR Agent">
          <Directory Id="RULESROOT" Name="rules"/>
          <Directory Id="MODELSROOT" Name="models"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <Component Id="cmpAgentExe" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="AgentExe"
              Source="$(var.EdrAgentExe)"
              Name="edr-agent.exe"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpEdrCtlExe" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="EdrCtlExe"
              Source="$(var.EdrCtlExe)"
              Name="edrctl.exe"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpEdrUIExe" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="EdrUIExe"
              Source="$(var.EdrUIExe)"
              Name="edr-agent-ui.exe"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpEdrUIManifest" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="EdrUIManifest"
              Source="edr-agent-ui.exe.manifest"
              Name="edr-agent-ui.exe.manifest"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpEdrInstallerExe" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="EdrInstallerExe"
              Source="$(var.EdrInstallerExe)"
              Name="edr-installer.exe"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpEdrAliasExe" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="EdrAliasExe"
              Source="$(var.EdrCtlExe)"
              Name="edr.exe"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpStartMenu" Guid="*" Directory="ProgramMenuFolder" Win64="yes">
        <Shortcut Id="StartMenuApp"
                  Name="EDR Agent"
                  Description="Open the EDR Agent console"
                  Target="[#EdrUIExe]"
                  WorkingDirectory="INSTALLFOLDER"/>
        <RegistryValue Root="HKLM"
                       Key="Software\RazaTech\EDR Agent"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes"/>
      </Component>
      <Component Id="cmpPath" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <Environment Id="EdrPath"
                     Name="PATH"
                     Value="[INSTALLFOLDER]"
                     Permanent="no"
                     Part="last"
                     Action="set"
                     System="yes"/>
        <RegistryValue Root="HKLM"
                       Key="Software\RazaTech\EDR Agent"
                       Name="path"
                       Type="string"
                       Value="[INSTALLFOLDER]"
                       KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigFile"
              Source="$(var.EdrConfigYml)"
              Name="config.yml"
              KeyPath="yes"/>
        <CreateFolder/>
      </Component>
      <Component Id="cmpConfigHardenedYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigHardenedFile"
              Source="$(var.EdrConfigHardenedYml)"
              Name="config.hardened.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigEnterpriseYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigEnterpriseFile"
              Source="$(var.EdrConfigEnterpriseYml)"
              Name="config.enterprise.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigFleetYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigFleetFile"
              Source="$(var.EdrConfigFleetYml)"
              Name="config.fleet.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigTenantYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigTenantFile"
              Source="$(var.EdrConfigTenantYml)"
              Name="config.tenant.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigFleetTlsYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigFleetTlsFile"
              Source="$(var.EdrConfigFleetTlsYml)"
              Name="config.fleet.tls.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigTenantTlsYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigTenantTlsFile"
              Source="$(var.EdrConfigTenantTlsYml)"
              Name="config.tenant.tls.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigPPLYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigPPLFile"
              Source="$(var.EdrConfigPPLYml)"
              Name="config.ppl.yml"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpApplyTenantBat" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="ApplyTenantBat"
              Source="$(var.EdrApplyTenantBat)"
              Name="apply_tenant_config.bat"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpApplyTenantTlsBat" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="ApplyTenantTlsBat"
              Source="$(var.EdrApplyTenantTlsBat)"
              Name="apply_tenant_tls_config.bat"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpApplyPPLBat" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="ApplyPPLBat"
              Source="$(var.EdrApplyPPLBat)"
              Name="apply_am_ppl_config.bat"
              KeyPath="yes"/>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
