<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <!--
    One-click Windows sensor MSI:
      C:\Program Files\EDR Agent\edr-agent.exe
      C:\ProgramData\EDR Agent\config.yml + rules\
    Post-install custom action runs edr-agent with the install flag (registers and starts EDRAgent).
  -->
  <Product Id="*"
           Name="EDR Agent"
           Language="1033"
           Version="$(var.MsiProductVersion)"
           Manufacturer="RazaTech"
           UpgradeCode="7D3A6EE5-52D7-4D6A-9D66-6AFC9FA04A90">

    <Package InstallerVersion="500" Compressed="yes"
             InstallScope="perMachine"
             InstallPrivileges="elevated"/>

    <MajorUpgrade DowngradeErrorMessage=
      "A newer version of EDR Agent is already installed."/>
    <MediaTemplate EmbedCab="yes"/>

    <Feature Id="ProductFeature" Title="EDR Agent" Level="1">
      <ComponentGroupRef Id="ProductComponents"/>
      <ComponentGroupRef Id="RulesComponents"/>
    </Feature>

    <CustomAction Id="CaInstallService"
                  FileKey="AgentExe"
                  ExeCommand="--install"
                  Execute="deferred"
                  Impersonate="no"
                  Return="check"/>

    <CustomAction Id="CaUninstallService"
                  FileKey="AgentExe"
                  ExeCommand="--uninstall"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore"/>

    <InstallExecuteSequence>
      <Custom Action="CaUninstallService" Before="RemoveFiles">REMOVE="ALL"</Custom>
      <Custom Action="CaInstallService" After="InstallFiles">NOT REMOVE</Custom>
    </InstallExecuteSequence>
  </Product>

  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="EDR Agent"/>
      </Directory>
      <Directory Id="CommonAppDataFolder">
        <Directory Id="DATAROOT" Name="EDR Agent">
          <Directory Id="RULESROOT" Name="rules"/>
        </Directory>
      </Directory>
    </Directory>
  </Fragment>

  <Fragment>
    <ComponentGroup Id="ProductComponents">
      <Component Id="cmpAgentExe" Guid="*" Directory="INSTALLFOLDER" Win64="yes">
        <File Id="AgentExe"
              Source="$(var.EdrAgentExe)"
              Name="edr-agent.exe"
              KeyPath="yes"/>
      </Component>
      <Component Id="cmpConfigYml" Guid="*" Directory="DATAROOT" Win64="yes">
        <File Id="ConfigFile"
              Source="$(var.EdrConfigYml)"
              Name="config.yml"
              KeyPath="yes"/>
        <CreateFolder/>
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
