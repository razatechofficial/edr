# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env

.venv/
ml/training/.venv/

# Populated only when building edr-installer-embedded (see Makefile)
cmd/installer/bundle/models/
cmd/installer/bundle/rules/
cmd/installer/bundle/bin/
rules/ioc/raw/
__pycache__/

# Local / build outputs
.DS_Store
/agent
/controlplane
/edrctl
dist/*.pkg
ml/datasets/
.cache/
.huggingface/
ml/training/keys/
ml/training/output/
ml/models/
models/keys/
models/behavior_lstm_beth_v5/
output/
models/model_signing.key
models/*.pt
models/*.npy
models/*.png
models/network_cic_train_out/
models/network_train_out/

*.md
!docs/*.md
/bin/
/alerts/
platform/linux/ebpf/vmlinux.h

# Python build/test artifacts
*.pyc
*.egg-info/
.pytest_cache/
.mypy_cache/

# Editor/IDE
# .idea/
# .vscode/

temp/
dist/
pkg/deb-build/
pkg/deb/
pkg/macos/sign_manifest
pkg/macos/root/usr/local/libexec/
pkg/macos/root/Library/Application Support/
