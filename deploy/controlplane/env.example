# Copy to /etc/edr-controlplane/env and adjust for production.
EDR_CONTROLPLANE_GRPC=:50051
EDR_CONTROLPLANE_HTTP=:8080
EDR_CONTROLPLANE_DATA=/var/lib/edr-controlplane

# TLS (optional). Run: scripts/deploy/enable_controlplane_tls.sh [hostname]
# EDR_CONTROLPLANE_TLS_CERT=/etc/edr-controlplane/tls/server.crt
# EDR_CONTROLPLANE_TLS_KEY=/etc/edr-controlplane/tls/server.key
# EDR_CONTROLPLANE_TLS_CLIENT_CA=/etc/edr-controlplane/tls/ca.crt
# EDR_CONTROLPLANE_MUTUAL_TLS=true
